GEMINI_API_KEY=your_google_ai_studio_api_key
PORT=3210
# Optional label to match the key-owning project in Google Cloud Billing.
GOOGLE_CLOUD_PROJECT_LABEL=
# Optional: retains full base64 audio in protocol logs (large and contains your voice).
# Byte counts, sample rates, duration and SHA-256 are always recorded.
LOG_AUDIO_PAYLOADS=false
